{
  "name": "note-galaxy",
  "version": "1.2.0",
  "description": "3D note graph with accretion disk, for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "pretest": "esbuild preview/i18n-test.ts --bundle --format=cjs --platform=node --external:obsidian --outfile=preview/i18n-test.cjs --log-level=warning",
    "test": "node preview/i18n-run.js && node preview/plugin-smoke.js"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "3d",
    "graph",
    "webgl"
  ],
  "license": "MIT",
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "esbuild": "0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.3"
  }
}
